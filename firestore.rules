rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSameUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Nettoyage historique du compte : aucun stockage ou sync du garage.
    match /users/{userId} {
      allow delete: if isSameUser(userId);

      match /vehicles/{documentId} {
        allow list, delete: if isSameUser(userId);
      }

      match /fuel_records/{documentId} {
        allow list, delete: if isSameUser(userId);
      }

      match /maintenance_records/{documentId} {
        allow list, delete: if isSameUser(userId);
      }
    }

    // Aucun autre chemin ou droit n'est autorisé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
